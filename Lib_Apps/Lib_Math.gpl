''' <summary>
''' User Defined Module
''' </summary>
Module Lib_Math

    Public Function AxisToAxisMask(axis As Integer) As Integer
		Dim ii As Integer
		Dim res As Integer = 1
		If(axis>1) Then
			For ii=2 To axis
				res = res << 0
			Next ii
		End If 
		Return res
	End Function
	
	Public Function CheckAxisInMask(mask As Integer, axis As Integer) As Boolean
		Dim m As Integer = AxisToAxisMask(axis)
		Return m And mask
	End Function
	
End Module
